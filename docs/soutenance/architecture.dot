digraph Architecture {
  graph [rankdir=TB, bgcolor="#faf9f6", pad="0.35", nodesep="0.5", ranksep="0.7", fontname="DejaVu Sans", fontsize=16];
  node [shape=record, fontname="DejaVu Sans", fontsize=12, style=filled, fillcolor="white", color="#5c36bf", fontcolor="#242135", penwidth=1.5, margin="0.12,0.09"];
  edge [color="#797186", fontname="DejaVu Sans", fontsize=10, fontcolor="#5b576b", arrowsize=0.7, style=dashed];
  client [label="{«client»|Utilisateur / logiciel HTTP}"];
  ods [label="{«source externe»|OpenAgenda via Opendatasoft}"];
  mistral [label="{«service externe»|API Mistral|mistral-embed\lministral-8b-2512 (demo)\lSmall (evaluation juillet)\l}"];
  subgraph cluster_docker {
    label="Environnement Docker du POC"; color="#dcd7e4"; style=rounded; fontcolor="#5c36bf";
    api [label="{«interface» FastAPI|GET /health\lPOST /ask\lPOST /rebuild\lGET /docs\l}"];
    service [label="{OpenAgendaRAGService|ask(question)\lrebuild(...)\lhealth()\l}"];
    rag [label="{«module» rag.py|answer_question(...)\lbuild_prompt()\lbuild_retriever(...)\l}"];
    index [label="{«module» indexing.py|build_documents(...)\lbuild_vector_store(...)\lload_vector_store(...)\l}"];
    faiss [label="{«artefact local»|FAISS IndexFlatL2|14 903 vecteurs\l1 024 dimensions\l}"];
    parquet [label="{«artefact local»|events.parquet|7 586 événements\l}"];
    api -> service [label="appelle"];
    service -> rag [label="question"];
    service -> index [label="chargement / rebuild"];
    rag -> faiss [label="retriever top-k 4"];
    index -> faiss [label="construit / charge"];
    parquet -> index [label="entrée rebuild", style=solid];
  }
  collect [label="{«préparation» ingestion.py|Collecte, filtres, normalisation}"];
  client -> api [label="HTTP / JSON", style=solid];
  ods -> collect [label="données publiques", style=solid];
  collect -> parquet [label="export", style=solid];
  index -> mistral [label="embeddings corpus"];
  rag -> mistral [label="embedding question + chat"];
}
